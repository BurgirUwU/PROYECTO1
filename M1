:root {
    --celeste: #ccefff;
    --celeste-claro: #effbff;
    --celeste-fuerte: #75c9eb;
    --azul: #285f8f;
    --azul-oscuro: #183f68;
    --blanco: #ffffff;
    --borde: #8cbdd5;
}

* { box-sizing: border-box; }

body {
    margin: 0;
    min-height: 100vh;
    padding: 28px;
    font-family: Tahoma, Verdana, sans-serif;
    color: #24445c;
    background:
        radial-gradient(circle at 15% 20%, #fff 0 4px, transparent 5px),
        linear-gradient(#a8e2fa, #eafaff 65%, #bce9d1);
    background-size: 42px 42px, auto;
}

button { font: inherit; }

.nubes {
    position: fixed;
    width: 160px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255,255,255,.65);
    filter: blur(1px);
    z-index: -1;
}

.nube-1 { top: 8%; left: 5%; }
.nube-2 { right: 7%; bottom: 12%; transform: scale(1.3); }

.ventana {
    width: min(1180px, 100%);
    min-height: 720px;
    margin: auto;
    overflow: hidden;
    border: 3px solid var(--blanco);
    border-radius: 9px 9px 3px 3px;
    background: var(--celeste-claro);
    box-shadow: 0 0 0 2px #4b91b8, 9px 12px 0 rgba(32,83,110,.18);
}

.barra-titulo {
    min-height: 72px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: white;
    background: linear-gradient(180deg, #63c8ee 0%, #388bc2 52%, #2b72aa 53%, #69c9ed 100%);
    border-bottom: 2px solid #1d5b89;
}

.titulo-programa { display: flex; align-items: center; gap: 12px; }
.titulo-programa h1 { margin: 0; font-size: 23px; text-shadow: 2px 2px #245b89; }
.titulo-programa p { margin: 3px 0 0; font-size: 12px; }

.logo {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 2px outset white;
    border-radius: 50%;
    color: #24658e;
    background: linear-gradient(#fff, #c6f4ff);
    font: bold 28px Georgia, serif;
}

.botones-ventana { display: flex; gap: 5px; }
.botones-ventana span {
    width: 27px;
    height: 25px;
    display: grid;
    place-items: center;
    border: 2px outset #d9f5ff;
    background: #a4def3;
    color: #174f78;
    font-weight: bold;
}

.barra-info {
    min-height: 34px;
    padding: 7px 14px;
    display: flex;
    justify-content: flex-end;
    gap: 25px;
    font-size: 12px;
    background: linear-gradient(#f7fdff, #d2edf8);
    border-bottom: 1px solid var(--borde);
}

.boton-menu { display: none; }
.contenido { min-height: 575px; display: grid; grid-template-columns: 230px 1fr; }

.menu-lateral {
    padding: 18px 12px;
    background: linear-gradient(90deg, #bde9fa, #e6f8ff);
    border-right: 2px solid var(--borde);
}

.perfil { text-align: center; padding-bottom: 16px; border-bottom: 1px dashed #65a9ca; }
.avatar {
    width: 64px;
    height: 64px;
    margin: auto;
    display: grid;
    place-items: center;
    border: 3px double #4c94b9;
    border-radius: 50%;
    background: white;
    font-size: 30px;
}
.perfil p { margin: 8px 0 1px; font-weight: bold; color: var(--azul-oscuro); }
.perfil small { color: #4f7287; }

nav { margin-top: 18px; display: grid; gap: 8px; }
.opcion {
    width: 100%;
    padding: 11px 10px;
    border: 2px outset #dff7ff;
    border-radius: 3px;
    text-align: left;
    color: #245273;
    background: linear-gradient(#fafdff, #bce8f8);
    cursor: pointer;
}
.opcion:hover, .opcion.activa {
    color: white;
    background: linear-gradient(#79d2ef, #3b8fc0);
    border-color: #a8e9ff;
}
.opcion:active { border-style: inset; }
.opcion.salir { margin-top: 12px; color: #7b3b52; background: linear-gradient(#fff, #f7d7e3); }
.opcion.salir:hover { color: white; background: linear-gradient(#ee9bb9, #bc6686); }

.estado-sistema { margin-top: 26px; text-align: center; font-size: 11px; }
.luz { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: #41c86d; box-shadow: 0 0 5px #41c86d; }

.area-trabajo { padding: 28px; background: rgba(255,255,255,.72); }
.seccion { display: none; }
.seccion.visible { display: block; }
.encabezado-seccion { display: flex; justify-content: space-between; align-items: end; border-bottom: 3px double var(--borde); padding-bottom: 12px; }
.ruta { margin: 0 0 6px; color: #65899f; font-size: 12px; }
h2 { margin: 0; color: var(--azul-oscuro); font-size: 25px; }
.etiqueta { padding: 5px 10px; border: 1px solid #76b7d3; border-radius: 12px; background: #dcf6ff; font-size: 11px; }

.mensaje-bienvenida {
    margin: 22px 0;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 15px;
    border: 1px solid #85bfd8;
    border-radius: 5px;
    background: linear-gradient(90deg, #d9f6ff, #f8fdff);
    box-shadow: inset 0 0 10px white;
}
.mensaje-bienvenida h3, .mensaje-bienvenida p { margin: 3px 0; }
.estrella { font-size: 34px; color: #ffcc57; text-shadow: 1px 1px #af8841; }

.tarjetas { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; }
.tarjeta {
    padding: 16px;
    min-height: 165px;
    border: 2px outset white;
    border-radius: 5px;
    background: linear-gradient(145deg, white, #d6f3ff);
    box-shadow: 3px 4px 0 #acd2e2;
}
.tarjeta .icono { font-size: 27px; }
.tarjeta p { min-height: 38px; margin: 10px 0 3px; font-size: 13px; }
.tarjeta strong { display: block; font: bold 32px "Trebuchet MS", sans-serif; color: #287aa9; }
.tarjeta small { color: #718b99; font-size: 10px; }

.panel-inferior {
    margin-top: 25px;
    padding: 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid #9ec7d9;
    background: repeating-linear-gradient(0deg, #eefbff 0 4px, #e4f7fd 4px 8px);
}
.panel-inferior h3, .panel-inferior p { margin: 4px 0; }
.reloj { padding: 10px; border: 1px inset white; background: white; font-size: 12px; }

.aviso-modulo { max-width: 600px; margin: 75px auto; padding: 35px; text-align: center; border: 2px outset white; background: #e5f8ff; box-shadow: 5px 6px 0 #a9d0e1; }
.monitor { font-size: 55px; margin-bottom: 15px; }
.aviso-modulo p { line-height: 1.6; }
.aviso-modulo button {
    padding: 9px 18px;
    border: 2px outset white;
    color: #174d72;
    background: linear-gradient(#fff, #a9ddf2);
    cursor: pointer;
}

footer { padding: 7px 12px; display: flex; justify-content: space-between; border-top: 1px solid #7aafc7; background: #c8eaf7; font-size: 10px; }
.notificacion { position: fixed; right: 25px; bottom: 25px; padding: 13px 18px; border: 2px outset white; background: #e1f8ff; box-shadow: 3px 4px 0 rgba(35,86,114,.25); opacity: 0; transform: translateY(15px); pointer-events: none; transition: .25s; }
.notificacion.mostrar { opacity: 1; transform: translateY(0); }

@media (max-width: 850px) {
    body { padding: 12px; }
    .contenido { grid-template-columns: 190px 1fr; }
    .tarjetas { grid-template-columns: repeat(2, 1fr); }
    .panel-inferior { align-items: flex-start; gap: 15px; flex-direction: column; }
}

@media (max-width: 620px) {
    body { padding: 0; }
    .ventana { min-height: 100vh; border-radius: 0; }
    .titulo-programa h1 { font-size: 18px; }
    .botones-ventana { display: none; }
    .barra-info { justify-content: space-between; align-items: center; gap: 8px; }
    .barra-info span:first-of-type { display: none; }
    .boton-menu { display: block; border: 1px outset white; background: #dff7ff; color: #23577a; }
    .contenido { display: block; position: relative; }
    .menu-lateral { position: absolute; z-index: 5; width: 230px; min-height: 100%; transform: translateX(-105%); transition: .25s; box-shadow: 5px 0 10px rgba(32,80,105,.25); }
    .menu-lateral.abierto { transform: translateX(0); }
    .area-trabajo { min-height: 650px; padding: 20px 14px; }
    .tarjetas { grid-template-columns: 1fr; }
    .tarjeta { min-height: 135px; }
    .encabezado-seccion { align-items: flex-start; gap: 12px; }
    footer { gap: 5px; }
}
