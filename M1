<!DOCTYPE html>
<html lang="es">
 
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>BancoWeb 2000 - Menú principal</title>

    <link rel="stylesheet" href="css/estilos.css">
</head>

<body>

    <div class="nubes nube-1"></div>
    <div class="nubes nube-2"></div>

    <div class="ventana">

        <header class="barra-titulo">

            <div class="titulo-programa">

                <span class="logo">$</span>

                <div>
                    <h1>BancoWeb 2000</h1>
                    <p>Sistema de Conciliación Bancaria</p>
                </div>

            </div>

            <div class="botones-ventana">
                <span>_</span>
                <span>□</span>
                <span>×</span>
            </div>

        </header>

        <div class="barra-info">

            <button id="botonMenu" class="boton-menu" type="button">
                ☰ Menú
            </button>

            <span>
                Usuario conectado:
                <strong>Administrador</strong>
            </span>

            <span id="fechaActual">
                Cargando fecha...
            </span>

        </div>

        <div class="contenido">

            <aside id="menuLateral" class="menu-lateral">

                <div class="perfil">

                    <div class="avatar">👤</div>

                    <p>¡Bienvenido!</p>
                    <small>Sesión activa</small>

                </div>

                <nav>

                    <button
                        class="opcion activa"
                        data-seccion="dashboard">
                        🏠 Dashboard
                    </button>

                    <button
                        class="opcion"
                        data-seccion="cheques">
                        🧾 Cheques
                    </button>

                    <button
                        class="opcion"
                        data-seccion="depositos">
                        💰 Depósitos
                    </button>

                    <button
                        class="opcion"
                        data-seccion="conciliacion">
                        🧮 Conciliación
                    </button>

                    <button
                        class="opcion"
                        data-seccion="reportes">
                        📊 Consultas / Reportes
                    </button>

                    <button
                        class="opcion salir"
                        data-seccion="salir">
                        🚪 Salir
                    </button>

                </nav>

                <div class="estado-sistema">
                    <span class="luz"></span>
                    Sistema en línea
                </div>

            </aside>

            <main class="area-trabajo">

                <section id="dashboard" class="seccion visible">

                    <div class="encabezado-seccion">

                        <div>
                            <p class="ruta">
                                Inicio &gt; Dashboard
                            </p>

                            <h2>Resumen bancario</h2>
                        </div>

                        <span class="etiqueta">
                            Período actual
                        </span>

                    </div>

                    <div class="mensaje-bienvenida">

                        <span class="estrella">✦</span>

                        <div>
                            <h3>Panel principal</h3>

                            <p>
                                Desde este menú podrás administrar las
                                operaciones bancarias de la institución.
                            </p>
                        </div>

                    </div>

                    <div class="tarjetas">

                        <article class="tarjeta">

                            <span class="icono">🧾</span>

                            <p>Cheques emitidos</p>

                            <strong>20</strong>

                            <small>Datos de demostración</small>

                        </article>

                        <article class="tarjeta">

                            <span class="icono">⏳</span>

                            <p>Cheques pendientes</p>

                            <strong>6</strong>

                            <small>Por verificar</small>

                        </article>

                        <article class="tarjeta">

                            <span class="icono">✖</span>

                            <p>Cheques anulados</p>

                            <strong>3</strong>

                            <small>Durante el período</small>

                        </article>

                        <article class="tarjeta">

                            <span class="icono">💾</span>

                            <p>Depósitos registrados</p>

                            <strong>15</strong>

                            <small>Datos de demostración</small>

                        </article>

                    </div>

                    <div class="panel-inferior">

                        <div>
                            <h3>Accesos rápidos</h3>

                            <p>
                                Selecciona una opción del menú lateral
                                para continuar.
                            </p>
                        </div>

                        <div class="reloj">
                            🕘 Última conciliación:
                            <strong>Agosto 2026</strong>
                        </div>

                    </div>

                </section>

                <section
                    id="proximamente"
                    class="seccion aviso-modulo">

                    <div class="monitor">🖥️</div>

                    <p class="ruta">
                        Inicio &gt;
                        <span id="nombreModulo">Módulo</span>
                    </p>

                    <h2 id="tituloModulo">
                        Módulo
                    </h2>

                    <p>
                        Esta sección se agregará en la siguiente
                        parte del proyecto.
                    </p>

                    <button id="volverDashboard" type="button">
                        Volver al Dashboard
                    </button>

                </section>

            </main>

        </div>

        <footer>

            <span>BancoWeb 2000 v1.0</span>

            <span>Desarrollo de Software IV</span>

        </footer>

    </div>

    <div
        id="notificacion"
        class="notificacion">
    </div>

    <script src="js/menu.js"></script>

</body>

</html>
